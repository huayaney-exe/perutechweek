# Copia a .env y completa. Todas son OPCIONALES — la app funciona sin ellas.

# Destino del CTA (agenda de Luma). Si se omite, usa la URL por defecto de PTW 2026.
VITE_LUMA_URL=https://luma.com/Perutechweek2026

# PostHog para medir el loop viral (badge_generated / badge_shared).
# Sin key, el tracking es un no-op silencioso. Autoriza PostHog y pega tu project key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
